---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCardIcon from '../../components/ProjectCardIcon.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Projects — Jirka Schlesinger"
  description="UX case snapshots from ten years at PwC — enterprise and AI-enabled products, with delivery-focused leadership."
  path="/projects/"
>
  <article>
    <header class="stack-md editorial-intro">
      <h1>Projects</h1>
      <p class="muted">
        Case snapshots from discovery through delivery. Details are summarized where confidentiality requires it.
      </p>
    </header>

    <div class="project-index">
      {
        projects.map((p) => (
          <a class="project-index-row" href={`/projects/${p.slug}/`}>
            <div class="project-index-row__glyph" aria-hidden="true">
              <ProjectCardIcon slug={p.slug} />
            </div>
            <div class="project-index-row__body">
              <h2 class="project-index-row__title">{p.data.title}</h2>
              <p class="project-index-row__summary">{p.data.focus}</p>
            </div>
          </a>
        ))
      }
    </div>

    <p class="project-index-footer-nav">
      <a href="/about/">Background & approach</a>
      <span class="muted"> · </span>
      <a href="/">Home</a>
    </p>
  </article>
</BaseLayout>
