---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCardIcon from '../../components/ProjectCardIcon.astro';
import { getCollection } from 'astro:content';
import { getProjectTopics, projectTopics } from '../../lib/project-topics';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const filterKeys = Object.keys(projectTopics) as Array<keyof typeof projectTopics>;
---

<BaseLayout
  title="Projects — Jirka Schlesinger"
  description="UX case snapshots from PwC — enterprise and AI-enabled products from design through leadership."
  path="/projects/"
>
  <article class="projects-page">
    <header class="page-intro">
      <p class="page-intro__label">Projects</p>
      <h1>Case snapshots</h1>
      <p class="page-intro__lede">
        Discovery through delivery in enterprise and AI-enabled work. Details are summarized where confidentiality requires it.
      </p>
    </header>

    <div class="project-filters" role="toolbar" aria-label="Filter projects by topic">
      <button class="project-filters__button is-active" type="button" data-filter="all" aria-pressed="true">All</button>
      {
        filterKeys.map((key) => (
          <button class="project-filters__button" type="button" data-filter={key} aria-pressed="false">
            {projectTopics[key]}
          </button>
        ))
      }
    </div>

    <div class="project-index" id="project-index">
      {
        projects.map((p) => (
          <a
            class="project-index-row"
            href={`/projects/${p.slug}/`}
            data-topics={getProjectTopics(p.slug).join(' ')}
          >
            <div class="project-index-row__glyph" aria-hidden="true">
              <ProjectCardIcon slug={p.slug} />
            </div>
            <div class="project-index-row__body">
              <h2 class="project-index-row__title">{p.data.title}</h2>
              <p class="project-index-row__summary">{p.data.focus}</p>
            </div>
          </a>
        ))
      }
    </div>

    <script>
      import '../../scripts/project-filters.ts';
    </script>

    <p class="project-index-footer-nav">
      <a href="/about/">Background & approach</a>
      <span class="muted"> · </span>
      <a href="/">Home</a>
    </p>
  </article>
</BaseLayout>
