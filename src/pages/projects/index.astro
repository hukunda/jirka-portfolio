---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCardIcon from '../../components/ProjectCardIcon.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Projects — Jirka Schlesinger"
  description="UX case snapshots — enterprise, AI-enabled products, and delivery-focused leadership."
  path="/projects/"
>
  <article>
    <header class="stack-md editorial-intro">
      <h1>Projects</h1>
      <p class="muted">
        Short snapshots for recruiters and hiring managers — each case page has more depth if you need it.
      </p>
    </header>

    <div class="project-index">
      {
        projects.map((p) => (
          <article class="project-index-row">
            <div class="project-index-row__glyph" aria-hidden="true">
              <ProjectCardIcon slug={p.slug} />
            </div>
            <div class="project-index-row__body">
              <h2 class="project-index-row__title">
                <a href={`/projects/${p.slug}/`}>{p.data.title}</a>
              </h2>
              <p class="project-index-row__summary">{p.data.focus}</p>
            </div>
          </article>
        ))
      }
    </div>

    <p class="project-index-footer-nav">
      <a href="/about/">About</a>
      <span class="muted"> · </span>
      <a href="/">Home</a>
    </p>
  </article>
</BaseLayout>
