---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProfileImage from '../components/ProfileImage.astro';
import FeaturedProjectCard from '../components/FeaturedProjectCard.astro';
import { getCollection } from 'astro:content';

const projectsSorted = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featuredProjects = projectsSorted.slice(0, 3);
---

<BaseLayout
  title="Jirka Schlesinger — UX Lead"
  description="UX Lead at PwC focused on complex and AI-enabled products — enterprise delivery, consulting, and practical UX leadership."
  path="/"
>
  <article class="stack-lg">
    <header class="intro-block intro-block--split intro-hero">
      <ProfileImage size="md" priority />
      <div class="intro-hero__intro">
        <h1>Jirka Schlesinger</h1>
        <p class="role-tagline">UX Lead focused on Complex & AI‑Enabled Products</p>
      </div>
    </header>

    <div class="intro-hero__body">
      <p class="lede">
        I have spent the past ten years at PwC leading UX on complex digital and AI‑enabled products. I help teams align on the problem, make trade‑offs
        explicit, and move from ambiguity to buildable solutions that stay useful after launch.
      </p>
      <p>
        I am a designer with about twenty years in design and thirteen in UX. I focus on practical outcomes, rapid prototyping when it helps teams learn,
        and AI‑assisted workflows when they make the work clearer and faster.
      </p>
      <p class="intro-closing">
        If you are working on a complex product and would like to compare notes, <a href="#talk">get in touch</a>.
      </p>
    </div>

    <section aria-labelledby="work-heading">
      <h2 id="work-heading">What I work on</h2>
      <p class="muted">
        UX, product ownership, AI‑enabled experiences, and enterprise delivery — with a focus on clarity, alignment, and work that ships.
      </p>
      <ul>
        <li>Leading UX across discovery, design, and delivery</li>
        <li>Shaping product and platform UX in complex environments</li>
        <li>Designing experiences for AI‑driven and data‑heavy tools</li>
      </ul>
    </section>

    <section aria-labelledby="selected-heading">
      <h2 id="selected-heading">Selected work</h2>
      <p class="muted">Case snapshots from discovery through delivery.</p>
      <div class="featured-projects-row">
        {
          featuredProjects.map((p) => (
            <FeaturedProjectCard slug={p.slug} title={p.data.title} focus={p.data.focus} />
          ))
        }
      </div>

      <p class="section-nav-links">
        <a class="action-link" href="/projects/">View all projects</a>
        <span class="muted"> · </span>
        <a class="action-link" href="/about/">Background, approach & skills</a>
      </p>
    </section>
  </article>
</BaseLayout>
