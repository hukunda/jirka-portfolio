---
/**
 * Project glyphs — themes per case (AI governance, documents, enterprise, catalogue search, monitoring, design system).
 */
interface Props {
  slug: string;
}

const { slug } = Astro.props;

const knownSlugs = new Set([
  'enterprise-tax-workflow',
  'responsible-ai-toolkit',
  'ai-document-data-platforms',
  'enterprise-digital-products',
  'ai-at-pwc',
  'financial-crime-suite',
  'lighting-design-system',
  'productivity-hub',
  'media-intelligence-platform',
  'connected-identity',
  'audit-report-reader',
  'powerbi-templates',
]);
---

<span class="project-card__icon" aria-hidden="true">
  {
    slug === 'enterprise-tax-workflow' && (
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M6 11 L10 7 L14 11" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M4 16.5 H16 V9.5 H10 V16.5 H4 Z" stroke="currentColor" stroke-width="1.35" stroke-linejoin="round" />
      </svg>
    )
  }
  {
    slug === 'powerbi-templates' && (
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M4 14 V9 M7.5 14 V6 M11 14 V11 M14.5 14 V7.5" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" />
        <path d="M3.5 14.5 H16.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
      </svg>
    )
  }
  {
    slug === 'responsible-ai-toolkit' && (
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path
          d="M10 3.5 L15.5 6.2 V10.2 C15.5 13.6 13.2 16.3 10 17.2 C6.8 16.3 4.5 13.6 4.5 10.2 V6.2 L10 3.5Z"
          stroke="currentColor"
          stroke-width="1.35"
          stroke-linejoin="round"
        />
        <path d="M7.25 10.2 L9 11.85 L12.85 8" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    )
  }
  {
    slug === 'ai-document-data-platforms' && (
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path
          d="M5.5 3.5 H11 L14.5 7 V16.5 H5.5 C5 16.5 4.5 16 4.5 15.5 V4.5 C4.5 4 5 3.5 5.5 3.5Z"
          stroke="currentColor"
          stroke-width="1.35"
          stroke-linejoin="round"
        />
        <path d="M11 3.5 V7 H14.5" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M7 10 H13 M7 12.25 H11.5 M7 14.5 H13" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
        <path d="M6 8.25 V6.25 H8" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" />
        <path d="M14 8.25 V6.25 H12" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" />
      </svg>
    )
  }
  {
    slug === 'enterprise-digital-products' && (
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M3.5 16.5 H16.5 V7 L10 4 L3.5 7 V16.5Z" stroke="currentColor" stroke-width="1.35" stroke-linejoin="round" />
        <path d="M3.5 11 H16.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
        <path d="M7 16.5 V11 M13 16.5 V11" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
        <path d="M8 8.5 H12 M9 6.25 H11" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" />
      </svg>
    )
  }
  {
    slug === 'ai-at-pwc' && (
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- AI tool catalogue: search across a grid of capabilities -->
        <circle cx="8" cy="8" r="3.25" stroke="currentColor" stroke-width="1.35" />
        <path d="M10.4 10.4 L13.5 13.5" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" />
        <path d="M14.5 4.5 H17 M14.5 7 H17 M14.5 9.5 H17" stroke="currentColor" stroke-width="1.15" stroke-linecap="round" />
      </svg>
    )
  }
  {
    slug === 'financial-crime-suite' && (
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- AML monitoring: signal in a controlled frame -->
        <rect x="3.5" y="5" width="13" height="10" rx="1" stroke="currentColor" stroke-width="1.35" />
        <path
          d="M5.5 13 L7.5 10 L9.5 11.5 L11.5 8 L13 9.5 L14.5 7.5"
          stroke="currentColor"
          stroke-width="1.25"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    )
  }
  {
    slug === 'lighting-design-system' && (
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- Design system: layered components + implementation bridge -->
        <rect x="4" y="4" width="12" height="3.5" rx="0.5" stroke="currentColor" stroke-width="1.25" />
        <rect x="4" y="9" width="12" height="3.5" rx="0.5" stroke="currentColor" stroke-width="1.25" />
        <rect x="4" y="14" width="12" height="3.5" rx="0.5" stroke="currentColor" stroke-width="1.25" />
        <path d="M16.5 6 L18 7.5 L16.5 9" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    )
  }
  {
    slug === 'productivity-hub' && (
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M4 4.5 H7 V15.5 H4 Z" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round" />
        <path d="M8.5 6 H11.5 V15.5 H8.5 Z" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round" />
        <path d="M13 5 H16 V15.5 H13 Z" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round" />
        <path d="M5 8 H6 M5 11 H6 M9 9 H11 M14 8 H15" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" />
      </svg>
    )
  }
  {
    slug === 'media-intelligence-platform' && (
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M4 14 V8 M7 14 V5 M10 14 V10 M13 14 V6.5 M16 14 V11" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" />
        <path d="M3.5 14.5 H16.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
        <path d="M5 4 Q10 2 15 4" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" opacity="0.55" />
      </svg>
    )
  }
  {
    slug === 'connected-identity' && (
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="6" cy="10" r="2.75" stroke="currentColor" stroke-width="1.35" />
        <circle cx="14" cy="10" r="2.75" stroke="currentColor" stroke-width="1.35" />
        <path d="M8.6 10 H11.4" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" />
        <path d="M10 5.5 V7.5 M10 12.5 V14.5" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" opacity="0.6" />
      </svg>
    )
  }
  {
    slug === 'audit-report-reader' && (
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path
          d="M5.5 3.5 H11 L14.5 7 V16.5 H5.5 C5 16.5 4.5 16 4.5 15.5 V4.5 C4.5 4 5 3.5 5.5 3.5Z"
          stroke="currentColor"
          stroke-width="1.35"
          stroke-linejoin="round"
        />
        <path d="M11 3.5 V7 H14.5" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M7 10 L9 11.75 L12.5 8.25" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    )
  }
  {
    !knownSlugs.has(slug) && (
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect x="3.5" y="4.5" width="13" height="11" rx="1" stroke="currentColor" stroke-width="1.35" />
        <path d="M6 9h8M6 12h5" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" />
      </svg>
    )
  }
</span>
