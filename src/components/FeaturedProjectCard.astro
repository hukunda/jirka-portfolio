---
import ProjectCardIcon from './ProjectCardIcon.astro';

interface Props {
  slug: string;
  title: string;
  focus: string;
  variant?: 'feature' | 'standard';
}

const { slug, title, focus, variant = 'standard' } = Astro.props;
---

<article class:list={['project-spotlight', variant === 'feature' && 'project-spotlight--feature']} data-featured-card>
  <a class="project-spotlight__link" href={`/projects/${slug}/`}>
    <div class="project-spotlight__glyph" aria-hidden="true">
      <ProjectCardIcon slug={slug} />
    </div>
    <div class="project-spotlight__body">
      <h3 class="project-spotlight__title">{title}</h3>
      <p class="project-spotlight__summary">{focus}</p>
    </div>
  </a>
</article>
