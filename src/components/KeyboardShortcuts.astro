---
interface Props {
  variant: 'global' | 'projects-index' | 'project-detail';
  compact?: boolean;
}

const { variant, compact = false } = Astro.props;

const shortcuts =
  variant === 'project-detail'
    ? [
        { keys: '← or K', action: 'Previous project' },
        { keys: '→, N, or J', action: 'Next project' },
        { keys: 'I or A', action: 'All projects' },
        { keys: 'H', action: 'Home' },
        { keys: 'P', action: 'Projects' },
        { keys: 'B', action: 'Background' },
      ]
    : variant === 'projects-index'
      ? [
          { keys: '↑ or K', action: 'Previous project' },
          { keys: '↓ or J', action: 'Next project' },
          { keys: 'H', action: 'Home' },
          { keys: 'B', action: 'Background' },
        ]
      : [
          { keys: 'H', action: 'Home' },
          { keys: 'P', action: 'Projects' },
          { keys: 'B', action: 'Background' },
        ];
---

<aside
  class:list={['keyboard-help', compact && 'keyboard-help--compact']}
  aria-label="Keyboard shortcuts"
>
  <p class="keyboard-help__title">Keyboard shortcuts</p>
  <ul class="keyboard-help__list">
    {
      shortcuts.map((shortcut) => (
        <li>
          <kbd>{shortcut.keys}</kbd>
          <span>{shortcut.action}</span>
        </li>
      ))
    }
  </ul>
</aside>
