---
import '../styles/global.css';
import KeyboardShortcuts from '../components/KeyboardShortcuts.astro';
import TalkToMe from '../components/TalkToMe.astro';

interface Props {
  title: string;
  description?: string;
  path?: string;
  projectPrev?: string;
  projectNext?: string;
}

const {
  title,
  description = 'Ten years at PwC from UX design to lead — complex and AI-enabled products, enterprise delivery, and practical UX leadership.',
  path = '/',
  projectPrev,
  projectNext,
} = Astro.props;
const canonical = new URL(path, Astro.site ?? 'https://example.com').href;
const pageType =
  path === '/'
    ? 'home'
    : path.startsWith('/about')
      ? 'about'
      : path === '/projects/'
        ? 'projects-index'
        : path.startsWith('/projects/')
          ? 'project-detail'
          : 'page';
const keyboardVariant =
  pageType === 'project-detail'
    ? 'project-detail'
    : pageType === 'projects-index'
      ? 'projects-index'
      : 'global';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    data-page={pageType}
    data-project-prev={projectPrev}
    data-project-next={projectNext}
  >
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <p class="site-title">
          <a href="/" aria-keyshortcuts="H">Jirka Schlesinger</a>
        </p>
        <nav class="nav" aria-label="Primary">
          <a
            href="/projects/"
            aria-current={path.startsWith('/projects') ? 'page' : undefined}
            aria-keyshortcuts="P"
          >Projects</a>
          <a
            href="/about/"
            aria-current={path.startsWith('/about') ? 'page' : undefined}
            aria-keyshortcuts="B"
          >Background</a>
        </nav>
      </div>
    </header>
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="wrap site-footer">
      <TalkToMe />
      <p class="contact-line contact-line--secondary">
        <a href="https://www.linkedin.com/in/jirkaschlesinger/">LinkedIn</a>
      </p>
      <details class="keyboard-help-toggle">
        <summary>Keyboard shortcuts</summary>
        <KeyboardShortcuts variant={keyboardVariant} compact />
      </details>
      <p class="site-colophon">
        <span class="muted">Built with </span>
        <a href="https://astro.build/">Astro</a>
      </p>
    </footer>
    <script>
      import '../scripts/keyboard-shortcuts.ts';
    </script>
  </body>
</html>
