---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  path?: string;
}

const {
  title,
  description = 'UX Lead focused on complex and AI-enabled products — enterprise delivery and practical UX leadership.',
  path = '/',
} = Astro.props;
const canonical = new URL(path, Astro.site ?? 'https://example.com').href;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <p class="site-title">
          <a href="/">Jirka Schlesinger</a>
        </p>
        <nav class="nav" aria-label="Primary">
          <a href="/projects/" aria-current={path.startsWith('/projects') ? 'page' : undefined}>Projects</a>
          <a href="/about/" aria-current={path.startsWith('/about') ? 'page' : undefined}>About</a>
        </nav>
      </div>
    </header>
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="wrap site-footer">
      <p class="contact-line">
        <span class="muted">Contact · </span>
        <a href="mailto:jiri.schlesinger@gmail.com">jiri.schlesinger@gmail.com</a>
        <span aria-hidden="true"> · </span>
        <a href="tel:+420735729761">+420 735 729 761</a>
        <span aria-hidden="true"> · </span>
        <a href="https://www.linkedin.com/in/jirkaschlesinger/">LinkedIn</a>
      </p>
      <p class="site-colophon">
        <span class="muted">Built with </span>
        <a href="https://astro.build/">Astro</a>
        <span class="muted">
          · Maintained in Cursor — iteration, refactors, and content with an AI-assisted workflow I use day to day.
        </span>
      </p>
    </footer>
  </body>
</html>
